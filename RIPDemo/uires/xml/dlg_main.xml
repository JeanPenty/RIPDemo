﻿<SOUI name="mainWindow"
	  title="@string/title"
	  bigIcon="ICON_LOGO:32"
	  smallIcon="ICON_LOGO:16"
	  width="1200"
      height="900"
      minsize="1200,900"
	  resizable="1"
	  wndType="appMain"
	  appWnd="1"
	  translucent="1"
	  trCtx="dlg_main" >
	<root>
		<caption pos="0,0,-0,-0" skin="skin_shadow">
			<caption name="cap_main" pos="15,15,-15,-15" colorBkgnd="#2D2D30" font="face:微软雅黑,size:12" colorBorder="#007ACC80" margin="1" ncSkin="">
				<caption pos="10,0,-0,@50" colorText="#FFFFFF">
					
					<menubar name="menu_file" size="-1,-2" valign="center" useMenuEx="1" dock="top">
						<btnstyle size="60,30" skin="skin_btn_comm60_30mb" padding="2"/>
						<menus>
							<menuItem src="SMENU:menu_file">文件(F)</menuItem>
						</menus>
					</menubar>
					<text pos="[10,0,@100,@50" align="left" valign="center" font="face:微软雅黑,size:12,bold:1" >RIPPER</text>
					
					<imgbtn name="btn_close" pos="-30,0" skin="skin_btn_close" tip="关闭"/>
					<imgbtn name="btn_max" pos="-70,0" skin="skin_btn_max" show="1" tip="最大化"/>
					<imgbtn name="btn_restore" pos="-70,0" skin="skin_btn_restore" show="0" tip="还原"/>
					<imgbtn name="btn_min" pos="-100,0" skin="skin_btn_min" tip="最小化"/>
				</caption>
				<caption pos="0,[0,-0,-0" layout="hbox" colorBkgnd="#0B0F19">
					<caption weight="2" size="-1,-2">
						<listview pos="0,0,-5,-88" name="lv_rip_task" headHeight="0" colorBkgnd="#1A1F2E" focuable="0" sbSkin="skin_scrollbar" sbWid="8">
							<template itemHeight="40"  skin="" colorNormal="#1A1F2E" colorHover="#2D2D30" colorSelected="#00000030" 
									  trackMouseEvent="1" font="face:微软雅黑,size:12,adding:1" cursor="hand">
								<check name="item_check" pos="10,0,@30,-0" valign="center" focusable="0" tip="勾选后才参与「开始RIP」" />
								<text name="item_name" pos="[8,0,-15,-0" align="left" valign="center" dotted="1" colorText="#FFFFFF" />
							</template>
						</listview>

						<!-- 处理进度条: 按「页」推进, 总页数 = 所有待处理 PDF 的页数之和 -->
						<progress name="prog_rip" pos="0,-78,-5,@18"
								  bkgndSkin="skin_prog_rail" posSkin="skin_prog_fill"
								  min="0" max="100" value="0" showText="0"/>
						<text name="prog_text" pos="0,-56,-5,@24" colorText="#8A94A6" align="left"
							  font="face:微软雅黑,size:12">就绪</text>
					</caption>
					<caption weight="1" size="-1,-2">
						<text pos="20,[10,@80,@30" colorText="#FFFFFF">位深:</text>
						<combobox name="cbx_nozzle_type" 
								  pos="[0,{0,@120,@30" 
								  colorText="#FFFFFF"
								  btnSkin="skin_cbx_btn" 
								  dropDown="1"
								  dropHeight="300" 
								  colorBorder="#FFFFFF30" 
								  margin="1"
								  class="cls_edit" 
								  dotted="0" 
								  colorBkgnd="#1A1F2E"
								  focusable="0" >
							<liststyle itemHeight="30" colorText="#FFFFFF" colorBkgnd="#1A1F2E" colorSelText="#FFFFFF90" colorItemBkgnd="#1A1F2E"
									   colorItemHotBkgnd="#2D2D30" colorItemSelBkgnd="#00000030" font="face:微软雅黑,size:12"
									   class="cls_cbxlist_border" sbSkin="skin_scrollbar" sbWid="8" itemSkin=""/>
							<editstyle readOnly="0" inset="5,0,5,0" margin="0" colorText="#FFFFFF" align="left" focusable="0"/>
							<items>
								<item text="1bit" />
								<item text="2bit" />
							</items>
						</combobox>

						<text pos="20,[10,@80,@30" colorText="#FFFFFF">X DPI:</text>
						<edit name="edit_x_dpi" pos="[0,{0,@120,@30" 
							  colorBkgnd="#1A1F2E" align="left" valign="center" colorBorder="#FFFFFF30" ncSkin="" margin="1"
							  inset="5,0,5,0" font="face:微软雅黑,size:12" autoWordSel="0" colorText="#FFFFFF"/>

						<text pos="[50,{0,@80,@30" colorText="#FFFFFF">Y DPI:</text>
						<edit name="edit_y_dpi" pos="[0,{0,@120,@30"
							  colorBkgnd="#1A1F2E" align="left" valign="center" colorBorder="#FFFFFF30" ncSkin="" margin="1"
							  inset="5,0,5,0" font="face:微软雅黑,size:12" autoWordSel="0" colorText="#FFFFFF"/>

						<check name="check_spot" pos="[50,{7" focusable="0" colorText="#FFFFFF">专色分离</check>

						<check name="check_gray2k" pos="20,[25" focusable="0" colorText="#FFFFFF" tip="黑色/灰色只用黑版表达,剔除CMY,黑字不再有彩色毛边">灰色只用K</check>
						
						<text pos="20,[20,@80,@30" colorText="#FFFFFF" tip="0=关闭,100=完全硬切;消除文字边缘抗锯齿毛边,图片类内容慎用">锐化:</text>
						<edit name="edit_noaa" pos="[0,{0,@70,@30"
							  colorBkgnd="#1A1F2E" align="left" valign="center" colorBorder="#FFFFFF30" ncSkin="" margin="1"
							  inset="5,0,5,0" font="face:微软雅黑,size:12" autoWordSel="0" colorText="#FFFFFF"/>
						<check name="check_noaa" pos="[20,{7" focusable="0" colorText="#FFFFFF" tip="对墨量做S曲线压掉边缘过渡灰阶;图片类内容慎用">去毛边</check>

						<text pos="20,[15,@80,@30" colorText="#FFFFFF" tip="喷头板卡 PRN 容器格式: PRN1RipHeader(256字节头, 行内 K,C,M,Y) 或 PRN2RipHeader(48字节头, 行内 C,M,Y,K); 每页额外落一份 .prn, 专色版不参与">输出PRN:</text>
						<combobox name="cb_prn" pos="[0,{0,@170,@30"
								  colorText="#FFFFFF"
								  btnSkin="skin_cbx_btn"
								  dropDown="1"
								  dropHeight="200"
								  colorBorder="#FFFFFF30"
								  margin="1"
								  class="cls_edit"
								  dotted="0"
								  colorBkgnd="#1A1F2E"
								  focusable="0" >
							<liststyle itemHeight="30" colorText="#FFFFFF" colorBkgnd="#1A1F2E" colorSelText="#FFFFFF90" colorItemBkgnd="#1A1F2E"
									   colorItemHotBkgnd="#2D2D30" colorItemSelBkgnd="#00000030" font="face:微软雅黑,size:12"
									   class="cls_cbxlist_border" sbSkin="skin_scrollbar" sbWid="8" itemSkin=""/>
							<editstyle readOnly="0" inset="5,0,5,0" margin="0" colorText="#FFFFFF" align="left" focusable="0"/>
							<items>
								<item text="不输出" />
								<item text="PRN1 (5458008)" />
								<item text="PRN2 (1381564416)" />
							</items>
						</combobox>

						<text pos="20,[15,@80,@30" colorText="#FFFFFF" tip="FS=Floyd-Steinberg误差扩散,层次最细腻(默认); 有序网屏=4x4网点,网点规整稳定; 纯阈值=不出网">抖动:</text>
						<combobox name="cb_dither" pos="[0,{0,@130,@30"
								  colorText="#FFFFFF"
								  btnSkin="skin_cbx_btn"
								  dropDown="1"
								  dropHeight="300"
								  colorBorder="#FFFFFF30"
								  margin="1"
								  class="cls_edit"
								  dotted="0"
								  colorBkgnd="#1A1F2E"
								  focusable="0" >
							<liststyle itemHeight="30" colorText="#FFFFFF" colorBkgnd="#1A1F2E" colorSelText="#FFFFFF90" colorItemBkgnd="#1A1F2E"
									   colorItemHotBkgnd="#2D2D30" colorItemSelBkgnd="#00000030" font="face:微软雅黑,size:12"
									   class="cls_cbxlist_border" sbSkin="skin_scrollbar" sbWid="8" itemSkin=""/>
							<editstyle readOnly="0" inset="5,0,5,0" margin="0" colorText="#FFFFFF" align="left" focusable="0"/>
							<items>
								<item text="FS误差扩散" />
								<item text="有序网屏" />
								<item text="纯阈值" />
							</items>
						</combobox>
						<check name="check_fsserp" pos="[20,{7" focusable="0" colorText="#FFFFFF" tip="蛇形扫描: 逐行来回走,消除单向拖尾纹理(仅FS有效)">FS蛇形</check>

						<text pos="20,[15,@80,@30" colorText="#FFFFFF" tip="页级并行处理线程数: 0=自动(按CPU核心数,最多8); 1=串行。线程越多占用内存越多">线程数:</text>
						<edit name="edit_threads" pos="[0,{0,@70,@30"
							  colorBkgnd="#1A1F2E" align="left" valign="center" colorBorder="#FFFFFF30" ncSkin="" margin="1"
							  inset="5,0,5,0" font="face:微软雅黑,size:12" autoWordSel="0" colorText="#FFFFFF"/>

						<group pos="20,[20,-5,@60" text="ICC曲线(CMYK分色曲线)" colorText="#FFFFFF" align="left" headerHeight="20">
							<edit name="edit_icc_path" pos="10,0,-100,@30"
								  colorBkgnd="#1A1F2E" align="left" valign="center" colorBorder="#FFFFFF30" ncSkin="" margin="1"
								  inset="5,0,5,0" font="face:微软雅黑,size:12" autoWordSel="0" colorText="#FFFFFF"/>

							<button name="btn_log_all" pos="[5,{-5,-5,-5" focusable="0"
									skin="skin_alpha" colorText="#64748B" colorTextHover="#FFFFFF" colorTextPush="#3B82F6"
									font="face:微软雅黑,size:12" cursor="hand">选择文件</button>
						</group>

						<group pos="20,[10,-5,@60" text="输出根目录（留空 = 跟随 PDF 所在目录）" colorText="#FFFFFF" align="left" headerHeight="20">
							<edit name="edit_outroot" pos="10,0,-100,@30"
								  colorBkgnd="#1A1F2E" align="left" valign="center" colorBorder="#FFFFFF30" ncSkin="" margin="1"
								  inset="5,0,5,0" font="face:微软雅黑,size:12" autoWordSel="0" colorText="#FFFFFF"
								  tip="大作业输出动辄几十 GB，可指到数据盘；输出写到 该目录 / RIP_Out / PDF文件名 / ；留空则写到 PDF 同级目录"/>

							<button name="btn_outroot" pos="[5,{-5,-5,-5" focusable="0"
									skin="skin_alpha" colorText="#64748B" colorTextHover="#FFFFFF" colorTextPush="#3B82F6"
									font="face:微软雅黑,size:12" cursor="hand">选择文件夹</button>
						</group>

						<group pos="20,[10,-5,@65" text="颜色阈值（过滤掉低于各分量阈值的数据）" colorText="#FFFFFF" align="left" headerHeight="20">
							<text pos="10,[0,@30,@30" >C:</text>
							<edit name="edit_threshold_c" pos="[0,{0,@80,@30"
								  colorBkgnd="#1A1F2E" align="left" valign="center" colorBorder="#FFFFFF30" ncSkin="" margin="1"
								  inset="5,0,5,0" font="face:微软雅黑,size:12" autoWordSel="0" colorText="#FFFFFF"/>

							<text pos="[20,{0,@30,@30" >M:</text>
							<edit name="edit_threshold_m" pos="[0,{0,@80,@30"
								  colorBkgnd="#1A1F2E" align="left" valign="center" colorBorder="#FFFFFF30" ncSkin="" margin="1"
								  inset="5,0,5,0" font="face:微软雅黑,size:12" autoWordSel="0" colorText="#FFFFFF"/>

							<text pos="[20,{0,@30,@30">Y:</text>
							<edit name="edit_threshold_y" pos="[0,{0,@80,@30"
								  colorBkgnd="#1A1F2E" align="left" valign="center" colorBorder="#FFFFFF30" ncSkin="" margin="1"
								  inset="5,0,5,0" font="face:微软雅黑,size:12" autoWordSel="0" colorText="#FFFFFF"/>

							<text pos="[20,{0,@30,@30" >K:</text>
							<edit name="edit_threshold_k" pos="[0,{0,@80,@30"
								  colorBkgnd="#1A1F2E" align="left" valign="center" colorBorder="#FFFFFF30" ncSkin="" margin="1"
								  inset="5,0,5,0" font="face:微软雅黑,size:12" autoWordSel="0" colorText="#FFFFFF"/>
						</group>
						<group pos="20,[10,-5,@232" text="墨点统计（第 1 页 · 点数 / 耗墨量）" colorText="#FFFFFF" align="left" headerHeight="20">
							<text pos="10,4,@56,@22" colorText="#FFFFFF" font="face:微软雅黑,size:12" align="left" tip="每颗墨滴的体积(皮升 pL), 按实际喷头规格填(常见: 小点1.5~4, 中点5~9, 大点12~30); 改完点一下别处即刻重算">小点pL:</text>
							<edit name="edit_drop_small_pl" pos="[2,{0,@54,@22" 
								  colorBkgnd="#1A1F2E" align="left" valign="center" colorBorder="#FFFFFF30" ncSkin="" margin="1"
									  inset="5,0,5,0" font="face:微软雅黑,size:12" autoWordSel="0" colorText="#FFFFFF"/>
							<text pos="[12,{0,@56,@22" colorText="#FFFFFF" font="face:微软雅黑,size:12" align="left">中点pL:</text>
							<edit name="edit_drop_mid_pl" pos="[2,{0,@54,@22" 
								  colorBkgnd="#1A1F2E" align="left" valign="center" colorBorder="#FFFFFF30" ncSkin="" margin="1"
									  inset="5,0,5,0" font="face:微软雅黑,size:12" autoWordSel="0" colorText="#FFFFFF"/>
							<text pos="[12,{0,@56,@22" colorText="#FFFFFF" font="face:微软雅黑,size:12" align="left">大点pL:</text>
							<edit name="edit_drop_big_pl" pos="[2,{0,@54,@22" 
								  colorBkgnd="#1A1F2E" align="left" valign="center" colorBorder="#FFFFFF30" ncSkin="" margin="1"
									  inset="5,0,5,0" font="face:微软雅黑,size:12" autoWordSel="0" colorText="#FFFFFF"/>
							<text pos="[12,{0,@84,@22" colorText="#FFFFFF" font="face:微软雅黑,size:12" align="left" tip="墨水单价(元/毫升): 总墨量(mL) x 单价 = 墨水成本, 改完点一下别处即刻重算; 填 0 表示不统计成本">墨价¥/mL:</text>
							<edit name="edit_ink_price_ml" pos="[2,{0,@70,@22" 
								  colorBkgnd="#1A1F2E" align="left" valign="center" colorBorder="#FFFFFF30" ncSkin="" margin="1"
									  inset="5,0,5,0" font="face:微软雅黑,size:12" autoWordSel="0" colorText="#FFFFFF"/>

							<text name="dot_line_c" pos="10,[10,-10,@20" colorText="#FFFFFF" font="face:微软雅黑,size:12" align="left" />
							<text name="dot_line_m" pos="10,[0,-10,@20" colorText="#FFFFFF" font="face:微软雅黑,size:12" align="left" />
							<text name="dot_line_y" pos="10,[0,-10,@20" colorText="#FFFFFF" font="face:微软雅黑,size:12" align="left" />
							<text name="dot_line_k" pos="10,[0,-10,@20" colorText="#FFFFFF" font="face:微软雅黑,size:12" align="left" />
							<text name="dot_line_sum" pos="10,[4,-10,@20" colorText="#3B82F6" font="face:微软雅黑,size:12,bold:1" align="left" />
							<text name="dot_price" pos="10,[4,-10,@20" colorText="#F59E0B" font="face:微软雅黑,size:12,bold:1" align="left" />
							<text name="dot_tip" pos="10,[4,-10,@34" colorText="#8A94A6" font="face:微软雅黑,size:11" align="left" wordBreak="1" />
						</group>
					</caption>
				</caption>
			</caption>
		</caption>
	</root>
</SOUI>
